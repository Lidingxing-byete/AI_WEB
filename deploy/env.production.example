# 云服务器生产环境变量示例（复制为 /opt/xinzhen/apps/server/.env）
#
# 权限：chmod 600，属主 xinzhen。本文件不含真实密钥，密钥留空即可。
# 部署形态：云服务器 + Nginx 子路径（https://你的域名/xz/），
#           **云端 DeepSeek 为主**，本地 Ollama 不作为依赖（服务器上没有也不影响）。

# ---- 服务 ----
# 单 worker 必须由 systemd 保证（见 deploy/xinzhen.service），不要在此加 --reload

# ---- 模型来源：云优先 ----
# auto = 云端配置完整则优先云端；cloud = 固定云端（失败自动降级到规则层）
XZ_LLM_PREFERRED=cloud
XZ_LLM_ENABLED=1

# ---- 云端（L1）----
# 可选：deepseek / qwen / moonshot / zhipu / doubao / qianfan / siliconflow / openai / openrouter / groq
# （服务商与 base_url 由服务端白名单决定；测试者只能选 id，不能传地址）
XZ_CLOUD_PROVIDER=deepseek
XZ_CLOUD_MODEL=deepseek-chat
XZ_CLOUD_BASE_URL=https://api.deepseek.com
# 默认留空：云端调用由测试者在页面里填**自己的** Key（只存他的浏览器标签页，
# 随请求头发给后端、用完即丢，服务端不保存）。
# 仅在"让所有访客共用一把钥匙"时才填这里（会消耗你的额度，公开演示不建议）。
XZ_CLOUD_API_KEY=
XZ_CLOUD_TIMEOUT_S=60

# ---- 说明 ----
# 服务端不保存任何云端密钥，因此没有管理口令；请改为在 Nginx 层做限流/演示口令。

# ---- 本地模型（L2，服务器上通常没有，留默认即可）----
# 连不上会快速失败并降级，不会拖慢诊断
XZ_OLLAMA_HOST=http://127.0.0.1:11434
XZ_LLM_MODEL=qwen2.5-coder:7b
XZ_LLM_TIMEOUT_S=20
XZ_LLM_HEALTH_CACHE_S=60

# ---- 判定阈值（[待验证]，未做真实硬件校准）----
XZ_BAUD_TOLERANCE_PCT=2.0
XZ_GARBLE_NONPRINT_RATIO=0.15
XZ_GARBLE_MIN_BYTES=16
