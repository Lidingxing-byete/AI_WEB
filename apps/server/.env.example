# 芯诊 AI · 环境变量示例（XZ_ 前缀，与 app/config.py 完全一致）
#
# 使用方式：复制为 .env 后按需填写。.env 已被 .gitignore 排除，绝不入库。
# 未填写任何 Key 时系统仍可运行：本地 Ollama 可用则走本地模型，
# 否则自动降级到纯规则层（三级降级链）。

# ---- 云端模型（三级降级链 L1：DeepSeek，OpenAI 兼容接口）----
# 赛事红线：密钥只走环境变量或服务端本机存储，绝不写入代码、文档或提交仓库
# 默认留空即可：测试者在页面「我的云端密钥」里填自己的 Key，
# 只存其浏览器标签页、随请求头发送、服务端不保存。
# 只有"让所有访客共用一把钥匙"时才需要填 XZ_CLOUD_API_KEY（会消耗你的额度）。
# 都不填则云端自动跳过（clone 即跑不依赖密钥）
# 可选：deepseek / qwen / moonshot / zhipu / siliconflow / openai / openrouter / groq
# （服务商与 base_url 由服务端白名单决定；测试者只能选 id，不能传地址）
XZ_CLOUD_PROVIDER=deepseek
XZ_CLOUD_MODEL=deepseek-chat      # 备选：deepseek-reasoner（R1 推理模式）
XZ_CLOUD_BASE_URL=https://api.deepseek.com
XZ_CLOUD_API_KEY=
# 模型来源偏好：auto=云端就绪优先否则本地（默认）；local=固定本地；cloud=固定云端（失败自动降级本地）
# 部署到云服务器（无本地模型）时建议 cloud：避免每轮都先去探测一个连不上的本地服务
XZ_LLM_PREFERRED=auto
# 云端请求超时（秒）。云端无冷启动，默认 60s 足够
XZ_CLOUD_TIMEOUT_S=60
# ---- 本地模型（L2，Ollama，仅 127.0.0.1）----
# 只使用已拉取的模型，脚本不会自行下载新模型。
# 默认 qwen2.5-coder:7b（2026-10-25 三模型选型结论）；qwen2.5:7b / qwen2.5:3b 可作备选
XZ_OLLAMA_HOST=http://127.0.0.1:11434
XZ_LLM_MODEL=qwen2.5-coder:7b
XZ_LLM_ENABLED=1
XZ_LLM_TIMEOUT_S=120
XZ_LLM_TEMPERATURE=0.2
XZ_LLM_MAX_TOKENS=700
XZ_LLM_HEALTH_CACHE_S=20

# ---- 判定阈值（[待验证]，Phase 5 硬件实测后校准）----
XZ_BAUD_TOLERANCE_PCT=2.0
XZ_GARBLE_NONPRINT_RATIO=0.15
XZ_GARBLE_MIN_BYTES=16

# ---- 评测（仅 eval/llm_baseline.py 使用）----
# 纯 LLM 基线采样次数：本地 7B 模型存在输出抖动，单次结果不可信
XZ_LLM_BASELINE_REPEAT=3
